# === DATABASE CONFIGURATION ===
# Options: 'local' (default with seed data), 'supabase', or 'mongodb'
DATABASE_TYPE=local

# Supabase (Free Tier: 500MB DB + 1GB Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# MongoDB Atlas (Free Tier: 512MB M0 cluster)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/productivity?retryWrites=true&w=majority

# === OBJECT STORAGE FOR IMAGES (Free Tier Options) ===
# Options: 'local' (default), 'cloudinary', 'supabase', 'uploadthing'
STORAGE_PROVIDER=local

# 1. Cloudinary (Free Tier: 25GB monthly credits)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# 2. Uploadthing (Free Tier: 2GB)
UPLOADTHING_SECRET=your-uploadthing-secret
UPLOADTHING_APP_ID=your-uploadthing-app-id

# Base URL for deployment (Optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000

